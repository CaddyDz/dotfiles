[push]
	default = simple
	autoSetupRemote = true
[user]
	name = Salim Djerbouh
	email = 13698160+CaddyDz@users.noreply.github.com
 	signingkey = ~/.ssh/id_ed25519.pub
[core]
	editor = vim
	autocrlf = false
	excludesfile = ~/.gitignore_global
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = false
[init]
	defaultBranch = master
[commit]
	gpgsign = true
[submodule]
	recurse = true
[gpg]
	format = ssh
