*.zip
*.tgz
*.log
*.log.*
.DS_Store

# Entries of ~/.config are linked here one by one (see links); only track real
# config, never app state or auth
.config/*
!.config/gh/
.config/gh/*
!.config/gh/config.yml
!.config/htop/
!.config/neofetch/
!.config/traefik/

# Docker
.docker/*
!.docker/config.json
!.docker/daemon.json

# Claude Code: only the shared rules, never session state or worktrees
.claude/*
!.claude/rules/

# scripts/inventory.sh output that can hold personal data; this repo is public
inventory/*/private/
