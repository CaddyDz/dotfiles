# This file lists the system wide environment variables

export HOMEBREW_EDITOR=vim
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export LESSHISTFILE=-
export MYSQL_HISTFILE=/dev/null
export NODE_REPL_HISTORY=''
export ZSH=$HOME/.oh-my-zsh
export ZSH_THEME="caddy"
export ZSH_DISABLE_COMPFIX=true
# Fixed name: keying on $HOST rebuilt the whole dump (~0.5s) every time macOS
# changed the hostname (VPN / DHCP reverse-DNS). One machine, one dump.
export ZSH_COMPDUMP=$ZSH/cache/.zcompdump
# Ignore cd and ls commands in history
export HIST_IGNORE="cd:ls"
# Default database for psql
export PGDATABASE="defaultdb"
